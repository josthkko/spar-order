# SPAR Slovenia account (online.spar.si)
SPAR_EMAIL=you@example.com
SPAR_PASSWORD=

# Delivery address id from `./spar addresses` (empty = first saved address)
SPAR_ADDRESS_ID=

# Comma-separated brands never to suggest as substitutes
SPAR_AVOID_BRANDS=

# Optional: weekly ping (`./spar due --telegram`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=

# Optional overrides if SPAR rotates its web client
#SPAR_TZ=Europe/Ljubljana
#SPAR_FIREBASE_API_KEY=
#SPAR_DPL_API_KEY=
